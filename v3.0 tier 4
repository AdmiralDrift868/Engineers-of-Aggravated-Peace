    # --- Export & Help ---
    def export_results(self):
        if not self.trajectory:
            QMessageBox.warning(self, "Warning", "No data to export.")
            return
        filename, _ = QFileDialog.getSaveFileName(self, "Export CSV", "", "CSV Files (*.csv)")
        if filename:
            if not filename.endswith('.csv'):
                filename += '.csv'
            try:
                with open(filename, 'w', newline='') as f:
                    writer = csv.writer(f)
                    writer.writerow(["Time(s)", "X(m)", "Y(m)", "Z(m)", "Vx(m/s)", "Vy(m/s)", "Vz(m/s)", "Roll(rad)", "Pitch(rad)", "Yaw(rad)", "RollRate", "PitchRate", "YawRate", "Mass(kg)"])
                    for point in self.trajectory:
                        writer.writerow([f"{p:.6f}" for p in point])
                QMessageBox.information(self, "Success", f"Exported to {filename}")
                log(f"Exported results to {filename}")
            except Exception as e:
                log(f"Export error: {e}", "error")
                QMessageBox.critical(self, "Error", f"Failed to export: {e}")

    def export_plot_to_png(self):
        if not MATPLOTLIB_AVAILABLE or not self.trajectory:
            QMessageBox.warning(self, "Warning", "No plot to export.")
            return
        filename, _ = QFileDialog.getSaveFileName(self, "Export PNG", "", "PNG Files (*.png)")
        if filename:
            if not filename.endswith('.png'):
                filename += '.png'
            try:
                self.figure.savefig(filename, dpi=150, bbox_inches='tight')
                QMessageBox.information(self, "Success", f"Exported plot to {filename}")
                log(f"Exported plot to {filename}")
            except Exception as e:
                log(f"Plot export error: {e}", "error")
                QMessageBox.critical(self, "Error", f"Failed to export plot: {e}")

    def export_presets(self):
        filename, _ = QFileDialog.getSaveFileName(self, "Export Presets", "", "JSON Files (*.json)")
        if filename:
            if not filename.endswith('.json'):
                filename += '.json'
            try:
                data = self.presets.copy()
                data["_metadata"] = {"version": "Tier4", "exported": str(QDateTime.currentDateTime())}
                with open(filename, 'w') as f:
                    json.dump(data, f, indent=2)
                QMessageBox.information(self, "Success", f"Exported presets to {filename}")
                log(f"Exported presets to {filename}")
            except Exception as e:
                log(f"Preset export error: {e}", "error")
                QMessageBox.critical(self, "Error", f"Failed to export presets: {e}")

    def import_presets(self):
        filename, _ = QFileDialog.getOpenFileName(self, "Import Presets", "", "JSON Files (*.json)")
        if filename:
            try:
                with open(filename, 'r') as f:
                    data = json.load(f)
                if "_metadata" in data:
                    data.pop("_metadata")
                valid = 0
                for name, preset in data.items():
                    if isinstance(preset, dict):
                        self.presets[name] = preset
                        valid += 1
                if valid > 0:
                    self.save_presets()
                    self.refresh_preset_combo()
                    QMessageBox.information(self, "Success", f"Imported {valid} presets.")
                    log(f"Imported {valid} presets from {filename}")
                else:
                    QMessageBox.warning(self, "Warning", "No valid presets found.")
            except Exception as e:
                log(f"Preset import error: {e}", "error")
                QMessageBox.critical(self, "Error", f"Failed to import presets: {e}")

