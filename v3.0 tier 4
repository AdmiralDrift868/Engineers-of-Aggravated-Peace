    def run_advanced_batch(self):
        if not MATPLOTLIB_AVAILABLE:
            QMessageBox.warning(self, "Warning", "Matplotlib is not installed.")
            return

        try:
            start = self.batch_start_input.value()
            end = self.batch_end_input.value()
            step = self.batch_step_input.value()
            param_to_sweep = self.batch_param_combo.currentText()

            if step <= 0:
                QMessageBox.warning(self, "Invalid Input", "Step size must be positive.")
                return
            if start > end:
                QMessageBox.warning(self, "Invalid Input", "Start value must be <= End value.")
                return

            base_params = self.get_current_parameters()
            batch_params = []
            current_val = start

            while current_val <= end:
                params = base_params.copy()
                if param_to_sweep == "Launch Angle":
                    params["launch_angle"] = math.radians(current_val)
                elif param_to_sweep == "Muzzle Velocity":
                    params["velocity"] = current_val
                elif param_to_sweep == "Wind Speed":
                    params["wind_field"] = self.generate_wind_field(current_val)
                else:
                    raise ValueError(f"Unknown parameter: {param_to_sweep}")

                batch_params.append(params)
                current_val += step

            if not batch_params:
                QMessageBox.warning(self, "Warning", "No parameters generated.")
                return

            self.batch_run_btn.setEnabled(False)
            self.batch_progress_bar.setValue(0)
            self.batch_table.setRowCount(0)
            self.status_bar.showMessage("Running batch calculations...")

            self.batch_thread = AdvancedBatchThread(self, batch_params)
            self.batch_thread.finished.connect(self.on_advanced_batch_complete)
            self.batch_thread.error.connect(self.on_advanced_batch_error)
            self.batch_thread.progress.connect(self.batch_progress_bar.setValue)
            self.batch_thread.start()

        except Exception as e:
            error_msg = f"Error setting up batch: {e}"
            log(error_msg, "error")
            QMessageBox.critical(self, "Error", error_msg)

    def on_advanced_batch_complete(self, results: List[Optional[List]]):
        self.batch_run_btn.setEnabled(True)
        self.status_bar.showMessage("Batch complete.")
        log("Batch calculations completed.")

        try:
            if not results:
                self.batch_table.setRowCount(0)
                QMessageBox.information(self, "Complete", "Batch finished, no results.")
                return

            self.batch_trajectories = results
            self.batch_table.setRowCount(len(results))

            for i, traj in enumerate(results):
                param_val = self.batch_start_input.value() + i * self.batch_step_input.value()
                param_str = f"{param_val:.3f}"
                max_height = distance = impact_velocity = 0.0

                if traj and len(traj) > 0:
                    try:
                        y_coords = [p[1] for p in traj]
                        max_height = max(y_coords) if y_coords else 0.0
                        distance = traj[-1][0]
                        vx, vy, vz = traj[-1][3], traj[-1][4], traj[-1][5]
                        impact_velocity = math.sqrt(vx**2 + vy**2 + vz**2)
                    except Exception as e:
                        log(f"Error processing batch result {i}: {e}", "warning")
                        param_str += " (Error)"
                else:
                    param_str += " (No Data)"

                items = [
                    QTableWidgetItem(str(i + 1)),
                    QTableWidgetItem(param_str),
                    QTableWidgetItem(f"{max_height:.2f}"),
                    QTableWidgetItem(f"{distance:.2f}"),
                    QTableWidgetItem(f"{impact_velocity:.2f}")
                ]
                for j, item in enumerate(items):
                    self.batch_table.setItem(i, j, item)

            self.batch_table.resizeColumnsToContents()
            QMessageBox.information(self, "Complete", f"Batch finished. {len(results)} runs.")

        except Exception as e:
            error_msg = f"Error processing batch results: {e}"
            log(error_msg, "error")
            QMessageBox.critical(self, "Error", error_msg)

    def on_advanced_batch_error(self, error_msg: str):
        self.batch_run_btn.setEnabled(True)
        QMessageBox.critical(self, "Error", f"Batch error:\n{error_msg}")
        self.status_bar.showMessage(f"Batch error: {error_msg}")
        log(f"Batch error: {error_msg}", "error")
        self.batch_progress_bar.setValue(0)
        self.batch_table.setRowCount(0)

    def run_advanced_monte_carlo(self):
        if not MATPLOTLIB_AVAILABLE:
            QMessageBox.warning(self, "Warning", "Matplotlib is not installed.")
            return

        try:
            num_runs = self.mc_runs_input.value()
            angle_spread = self.mc_angle_spread_input.value()
            vel_spread = self.mc_vel_spread_input.value()
            wind_spread = self.mc_wind_spread_input.value()

            if num_runs <= 0:
                QMessageBox.warning(self, "Invalid Input", "Number of runs must be positive.")
                return

            self.mc_run_btn.setEnabled(False)
            self.mc_progress_bar.setValue(0)
            self.status_bar.showMessage("Running Monte Carlo simulations...")

            base_params = self.get_current_parameters()
            self.mc_figure.clear()
            ax = self.mc_figure.add_subplot(111)
            successful_runs = 0

            for i in range(num_runs):
                params = base_params.copy()
                params["launch_angle"] += math.radians(random.uniform(-angle_spread, angle_spread))
                params["velocity"] += random.uniform(-vel_spread, vel_spread)
                base_wind = self.wind_speed_input.value()
                params["wind_field"] = self.generate_wind_field(
                    base_wind + random.uniform(-wind_spread, wind_spread)
                )

                params["launch_angle"] = clamp(params["launch_angle"], math.radians(0.1), math.radians(89.9))
                params["velocity"] = max(1.0, params["velocity"])

                try:
                    traj = self.advanced_calculator.calculate_trajectory_6dof(**self.convert_params_to_decimal(params))
                    if traj:
                        traj_float = [tuple(float(v) for v in point) for point in traj]
                        x = [p[0] for p in traj_float]
                        y = [p[1] for p in traj_float]
                        ax.plot(x, y, color="blue", alpha=0.1, linewidth=0.5)
                        successful_runs += 1
                except Exception as e:
                    log(f"MC Run {i+1} failed: {e}", "warning")

                self.mc_progress_bar.setValue(int((i + 1) / num_runs * 100))
                if i % 10 == 0:
                    QApplication.processEvents()

            ax.set_title(f'Monte Carlo Trajectory Spread ({successful_runs}/{num_runs} successful)')
            ax.set_xlabel('Distance (m)')
            ax.set_ylabel('Height (m)')
            ax.grid(True, alpha=0.3)
            self.mc_canvas.draw()

            self.mc_run_btn.setEnabled(True)
            self.status_bar.showMessage(f"Monte Carlo complete: {successful_runs}/{num_runs} successful.")
            log(f"Monte Carlo completed: {successful_runs}/{num_runs} successful.")

        except Exception as e:
            self.mc_run_btn.setEnabled(True)
            error_msg = f"Monte Carlo error: {e}"
            log(error_msg, "error")
            QMessageBox.critical(self, "Error", error_msg)

    # --- Helper Methods ---
    def generate_thrust_curve(self) -> Optional[Dict[Decimal, Decimal]]:
        if self.type_combo.currentText().lower() != 'rocket' or self.burn_time_input.value() <= 0:
            return None
        thrust = self.thrust_input.value()
        burn_time = self.burn_time_input.value()
        return {
            Decimal('0'): Decimal(str(thrust)),
            Decimal(str(burn_time * 0.1)): Decimal(str(thrust * 1.2)),
            Decimal(str(burn_time * 0.5)): Decimal(str(thrust)),
            Decimal(str(burn_time * 0.9)): Decimal(str(thrust * 0.8)),
            Decimal(str(burn_time)): Decimal('0'),
        }

    def generate_wind_field(self, speed: Optional[float] = None) -> List[Tuple[Decimal, Decimal, Decimal, Decimal]]:
        if speed is None:
            speed = self.wind_speed_input.value()
        angle_rad = math.radians(self.wind_angle_input.value())
        wx = speed * math.sin(angle_rad)
        wy = speed * math.cos(angle_rad)
        return [
            (Decimal('0'), Decimal(str(wx)), Decimal(str(wy)), Decimal('0')),
            (Decimal('1000'), Decimal(str(wx * 1.2)), Decimal(str(wy * 1.2)), Decimal('0')),
            (Decimal('5000'), Decimal(str(wx * 1.5)), Decimal(str(wy * 1.5)), Decimal('0')),
            (Decimal('10000'), Decimal(str(wx * 1.8)), Decimal(str(wy * 1.8)), Decimal('0')),
        ]

    def get_terrain_profile(self) -> List[Tuple[Decimal, Decimal]]:
        return DEFAULT_TERRAIN_PROFILE

    def load_terrain_profile(self):
        filename, _ = QFileDialog.getOpenFileName(self, "Load Terrain Profile", "", "CSV Files (*.csv)")
        if filename:
            try:
                profile = []
                with open(filename, 'r') as f:
                    for line in f:
                        if line.strip() and not line.startswith('#'):
                            parts = line.strip().split(',')
                            if len(parts) >= 2:
                                x = Decimal(parts[0].strip())
                                y = Decimal(parts[1].strip())
                                profile.append((x, y))
                if profile:
                    global DEFAULT_TERRAIN_PROFILE
                    DEFAULT_TERRAIN_PROFILE = profile
                    QMessageBox.information(self, "Success", f"Loaded {len(profile)} terrain points.")
                    log(f"Loaded terrain profile from {filename}")
                else:
                    QMessageBox.warning(self, "Warning", "No valid data found in file.")
            except Exception as e:
                error_msg = f"Failed to load terrain: {e}"
                log(error_msg, "error")
                QMessageBox.critical(self, "Error", error_msg)

