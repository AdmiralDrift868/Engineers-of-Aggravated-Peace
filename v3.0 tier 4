    def convert_params_to_decimal(self, params: Dict[str, Any]) -> Dict[str, Any]:
        decimal_params = {}
        for key, value in params.items():
            if isinstance(value, (int, float)):
                decimal_params[key] = Decimal(str(value))
            elif isinstance(value, dict) and key == 'thrust_curve' and value:
                decimal_params[key] = {Decimal(str(k)): Decimal(str(v)) for k, v in value.items()}
            elif isinstance(value, list) and key == 'wind_field' and value:
                decimal_params[key] = [(Decimal(str(p[0])), Decimal(str(p[1])), Decimal(str(p[2])), Decimal(str(p[3]))) for p in value]
            elif isinstance(value, list) and key == 'terrain_profile' and value:
                decimal_params[key] = [(Decimal(str(p[0])), Decimal(str(p[1]))) for p in value]
            else:
                decimal_params[key] = value
        return decimal_params

    def validate_advanced_inputs(self) -> bool:
        if self.mass_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Mass must be positive")
            return False
        if self.diam_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Diameter must be positive")
            return False
        if self.length_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Length must be positive")
            return False
        if self.velocity_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Velocity must be positive")
            return False
        if self.type_combo.currentText().lower() == 'rocket':
            if self.initial_mass_input.value() < self.mass_input.value():
                QMessageBox.warning(self, "Invalid Input", "Initial mass must be >= final mass")
                return False
            if self.burn_time_input.value() <= 0 and self.thrust_input.value() > 0:
                QMessageBox.warning(self, "Invalid Input", "Burn time must be > 0 if thrust > 0")
                return False
        if self.pressure_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Pressure must be positive")
            return False
        if self.coriolis_check.isChecked() and not (-90 <= self.latitude_input.value() <= 90):
            QMessageBox.warning(self, "Invalid Input", "Latitude must be between -90 and 90")
            return False
        return True

