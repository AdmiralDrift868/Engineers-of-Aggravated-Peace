# --- Utility Functions (Decimal) ---
def clamp(val: Decimal, vmin: Decimal, vmax: Decimal) -> Decimal:
    return max(vmin, min(val, vmax))

def linear_interpolate(x: Decimal, x0: Decimal, x1: Decimal, y0: Decimal, y1: Decimal) -> Decimal:
    if x1 == x0:
        return y0
    return y0 + ((y1 - y0) * (x - x0) / (x1 - x0))

def cubic_spline_interpolate(x: Decimal, x_points: List[Decimal], y_points: List[Decimal]) -> Decimal:
    """Cubic spline interpolation for smoother curves."""
    n = len(x_points)
    if n < 2:
        return y_points[0] if y_points else Decimal('0')
    if x <= x_points[0]:
        return y_points[0]
    if x >= x_points[-1]:
        return y_points[-1]
    for i in range(1, n):
        if x <= x_points[i]:
            x0, x1 = x_points[i-1], x_points[i]
            y0, y1 = y_points[i-1], y_points[i]
            if i == 1:
                m0 = (y1 - y0) / (x1 - x0)
                m1 = m0
            elif i == n-1:
                m0 = (y1 - y0) / (x1 - x0)
                m1 = m0
            else:
                m0 = (y1 - y_points[i-2]) / (x1 - x_points[i-2])
                m1 = (y_points[i+1] - y0) / (x_points[i+1] - x0)
            t = (x - x0) / (x1 - x0)
            h00 = (Decimal('1') + Decimal('2')*t) * (Decimal('1') - t)**2
            h10 = t * (Decimal('1') - t)**2
            h01 = t**2 * (Decimal('3') - Decimal('2')*t)
            h11 = t**2 * (t - Decimal('1'))
            return h00*y0 + h10*(x1-x0)*m0 + h01*y1 + h11*(x1-x0)*m1
    return y_points[-1]

