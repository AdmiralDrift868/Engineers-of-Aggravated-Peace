# --- Von Kármán Wind Turbulence Model ---
class VonKarmanTurbulence:
    def __init__(self, L: Decimal = Decimal('1000'), sigma_w: Decimal = Decimal('1.0')):
        self.L = L  # Turbulence scale (meters)
        self.sigma_w = sigma_w  # RMS velocity fluctuation (m/s)
        self.k = Decimal('0.4')  # von Kármán constant
        self.last_time = Decimal('0')
        self.last_wx = Decimal('0')
        self.last_wy = Decimal('0')
        self.last_wz = Decimal('0')

    def get_turbulence(self, t: Decimal, dt: Decimal) -> Tuple[Decimal, Decimal, Decimal]:
        """Generate correlated turbulence velocities."""
        # Simple first-order filter to simulate turbulence
        tau = self.L / Decimal('10')  # Correlation time
        alpha = dt / (dt + tau)
        noise_x = Decimal(str(random.gauss(0, float(self.sigma_w))))
        noise_y = Decimal(str(random.gauss(0, float(self.sigma_w))))
        noise_z = Decimal(str(random.gauss(0, float(self.sigma_w))))
        wx = (Decimal('1') - alpha) * self.last_wx + alpha * noise_x
        wy = (Decimal('1') - alpha) * self.last_wy + alpha * noise_y
        wz = (Decimal('1') - alpha) * self.last_wz + alpha * noise_z
        self.last_wx, self.last_wy, self.last_wz = wx, wy, wz
        self.last_time = t
        return wx, wy, wz

# --- Advanced Trajectory Calculator (Tier 3 & 4) ---
class AdvancedTrajectoryCalculator:
    """6-DOF Rigid Body Dynamics with CFD Coefficients, Magnus, Vectoring, and Turbulence."""

    def __init__(self):
        pass

    def calculate_trajectory_6dof(
        self,
        mass: Decimal,
        diameter: Decimal,
        length: Decimal,
        aerodynamic_model: str,
        velocity: Decimal,
        launch_angle: Decimal,
        launch_heading: Decimal,
        spin_rate: Decimal,
        fin_angle: Decimal,
        thrust_vector_angle: Decimal,
        mass_flow_rate: Decimal,
        burn_time: Decimal,
        thrust_curve: Optional[Dict[Decimal, Decimal]],
        altitude: Decimal,
        temperature: Decimal,
        pressure: Decimal,
        humidity: Decimal,
        wind_field: Optional[List[Tuple[Decimal, Decimal, Decimal, Decimal]]],
        turbulence_intensity: Decimal,
        coriolis: bool,
        latitude: Decimal,
        terrain_profile: Optional[List[Tuple[Decimal, Decimal]]],
        sensor_noise: bool = False,
        max_time: Decimal = Decimal('300.0'),
        tolerance: Decimal = Decimal('1e-8')
    ) -> List[Tuple[Decimal, ...]]:
        """
        Full 6-DOF trajectory with rigid body dynamics.
        State: [x, y, z, vx, vy, vz, phi, theta, psi, p, q, r, mass]
        phi=roll, theta=pitch, psi=yaw, p=roll_rate, q=pitch_rate, r=yaw_rate
        Returns list of state tuples.
        """
        try:
            # --- Initial State (6-DOF) ---
            x, y, z = Decimal('0'), altitude, Decimal('0')
            # Velocity in launch direction
            vx = velocity * launch_angle.cos() * launch_heading.cos()
            vy = velocity * launch_angle.sin()
            vz = velocity * launch_angle.cos() * launch_heading.sin()
            # Orientation: Assume roll=0, pitch=launch_angle, yaw=launch_heading
            phi, theta, psi = Decimal('0'), launch_angle, launch_heading
            # Angular rates: Assume starting from rest
            p, q, r = Decimal('0'), Decimal('0'), Decimal('0')
            current_mass = mass
            time = Decimal('0')

            # Moments of Inertia (simplified for cylinder)
            Ixx = current_mass * (Decimal('3') * diameter**2 + length**2) / Decimal('12')  # Roll
            Iyy = Izz = current_mass * (Decimal('3') * diameter**2 + length**2) / Decimal('12')  # Pitch/Yaw

            state = [x, y, z, vx, vy, vz, phi, theta, psi, p, q, r, current_mass]
            trajectory = [tuple(state + [time])]

            # Initialize turbulence model
            turbulence_model = VonKarmanTurbulence(sigma_w=turbulence_intensity)

            # --- Physics Functions ---
            def get_air_density(alt: Decimal) -> Decimal:
                sea_level_pressure = Decimal('101325')
                sea_level_temp = Decimal('288.15')
                lapse_rate = Decimal('0.0065')
                gas_constant_dry = Decimal('287.05')
                gas_constant_vapor = Decimal('461.495')
                temp_at_alt = sea_level_temp - lapse_rate * alt
                temp_at_alt = max(temp_at_alt, Decimal('100'))
                exponent = GRAVITY / (lapse_rate * gas_constant_dry)
                pressure_at_alt = sea_level_pressure * (Decimal('1') - (lapse_rate * alt) / sea_level_temp) ** exponent
                temp_c = temp_at_alt - Decimal('273.15')
                svp = Decimal('611.21') * (Decimal('18.678') - temp_c / Decimal('234.5')).exp() * (temp_c / (Decimal('257.14') + temp_c)).exp()
                pv = humidity * svp
                pd = pressure_at_alt - pv
                density_dry = pd / (gas_constant_dry * temp_at_alt)
                density_vapor = pv / (gas_constant_vapor * temp_at_alt)
                density_total = density_dry + density_vapor
                scale_height = Decimal('8500')
                density_total *= (alt / scale_height).exp().copy_negate()
                return density_total

            @lru_cache(maxsize=1024)
            def get_aero_coefficients(mach: Decimal, aoa: Decimal, roll: Decimal, model: str) -> Tuple[Decimal, Decimal, Decimal]:
                if model not in AERODYNAMIC_MODELS:
                    return Decimal('0.3'), Decimal('0.0'), Decimal('0.0')
                coeffs = AERODYNAMIC_MODELS[model]["coefficients"]
                keys = list(coeffs.keys())
                # Find nearest Mach and AoA (for simplicity; real code would interpolate)
                closest = min(keys, key=lambda k: (k[0] - mach)**2 + (k[1] - aoa)**2)
                Cd, Cl, Cm = coeffs[closest]
                # Roll effect: simple scaling
                if roll != 0:
                    Cl *= roll.cos()
                    Cm *= roll.cos()
                return Cd, Cl, Cm

            def get_wind_at_altitude(alt: Decimal) -> Tuple[Decimal, Decimal, Decimal]:
                if not wind_field:
                    return Decimal('0'), Decimal('0'), Decimal('0')
                alts = [w[0] for w in wind_field]
                if alt <= alts[0]:
                    return wind_field[0][1], wind_field[0][2], wind_field[0][3]
                if alt >= alts[-1]:
                    return wind_field[-1][1], wind_field[-1][2], wind_field[-1][3]
                for i in range(1, len(alts)):
                    if alt <= alts[i]:
                        w0, w1 = wind_field[i-1], wind_field[i]
                        frac = (alt - w0[0]) / (w1[0] - w0[0])
                        wx = w0[1] + frac * (w1[1] - w0[1])
                        wy = w0[2] + frac * (w1[2] - w0[2])
                        wz = w0[3] + frac * (w1[3] - w0[3])
                        return wx, wy, wz
                return Decimal('0'), Decimal('0'), Decimal('0')

            def get_terrain_elevation(x_pos: Decimal) -> Decimal:
                if not terrain_profile:
                    return Decimal('0')
                xs = [p[0] for p in terrain_profile]
                if x_pos <= xs[0]:
                    return terrain_profile[0][1]
                if x_pos >= xs[-1]:
                    return terrain_profile[-1][1]
                for i in range(1, len(xs)):
                    if x_pos <= xs[i]:
                        p0, p1 = terrain_profile[i-1], terrain_profile[i]
                        frac = (x_pos - p0[0]) / (p1[0] - p0[0])
                        return p0[1] + frac * (p1[1] - p0[1])
                return Decimal('0')

            def get_thrust(t: Decimal) -> Decimal:
                if not thrust_curve or t > burn_time:
                    return Decimal('0')
                times = sorted(thrust_curve.keys())
                if t <= times[0]:
                    return thrust_curve[times[0]]
                if t >= times[-1]:
                    return thrust_curve[times[-1]]
                for i in range(1, len(times)):
                    if t <= times[i]:
                        t0, t1 = times[i-1], times[i]
                        t0_thrust, t1_thrust = thrust_curve[t0], thrust_curve[t1]
                        return linear_interpolate(t, t0, t1, t0_thrust, t1_thrust)
                return Decimal('0')

            def derivatives(t: Decimal, state_vec: List[Decimal]) -> List[Decimal]:
                x, y, z, vx, vy, vz, phi, theta, psi, p, q, r, current_mass = state_vec
                speed = (vx**2 + vy**2 + vz**2).sqrt()
                mach = speed / SPEED_OF_SOUND if speed > 0 else Decimal('0')

                # Wind at current altitude + turbulence
                wx_base, wy_base, wz_base = get_wind_at_altitude(y)
                wx_turb, wy_turb, wz_turb = turbulence_model.get_turbulence(t, Decimal('0.01'))
                wx, wy, wz = wx_base + wx_turb, wy_base + wy_turb, wz_base + wz_turb
                v_rel_x, v_rel_y, v_rel_z = vx - wx, vy - wy, vz - wz
                v_rel = (v_rel_x**2 + v_rel_y**2 + v_rel_z**2).sqrt()

                # Angle of Attack (AoA) and Sideslip (Beta)
                aoa = theta  # Simplified
                beta = psi   # Simplified

                # Aero coefficients
                Cd, Cl, Cm = get_aero_coefficients(mach, aoa.degrees(), phi, aerodynamic_model)
                area = Decimal(math.pi) * (diameter / Decimal('2')) ** 2

                # Forces
                ax, ay, az = Decimal('0'), -GRAVITY, Decimal('0')
                if v_rel > 0:
                    density = get_air_density(y)
                    dynamic_pressure = Decimal('0.5') * density * v_rel**2
                    # Drag force
                    drag_force = Cd * dynamic_pressure * area
                    ax -= drag_force * v_rel_x / v_rel / current_mass
                    ay -= drag_force * v_rel_y / v_rel / current_mass
                    az -= drag_force * v_rel_z / v_rel / current_mass
                    # Lift force
                    lift_force = Cl * dynamic_pressure * area
                    lift_dir_x = -v_rel_y / v_rel
                    lift_dir_y = v_rel_x / v_rel
                    ax += lift_force * lift_dir_x / current_mass
                    ay += lift_force * lift_dir_y / current_mass
                    # Magnus force
                    if spin_rate != 0:
                        magnus_coeff = Decimal('0.1') * (spin_rate / Decimal('60000'))
                        magnus_force = magnus_coeff * dynamic_pressure * area
                        magnus_dir_y = -v_rel_z / v_rel
                        magnus_dir_z = v_rel_y / v_rel
                        ay += magnus_force * magnus_dir_y / current_mass
                        az += magnus_force * magnus_dir_z / current_mass

                # Thrust (with vectoring)
                thrust = get_thrust(t)
                if thrust > 0:
                    thrust_angle_rad = thrust_vector_angle.radians()
                    thrust_dir_x = thrust_angle_rad.cos() * psi.cos()
                    thrust_dir_y = thrust_angle_rad.sin()
                    thrust_dir_z = thrust_angle_rad.cos() * psi.sin()
                    ax += thrust * thrust_dir_x / current_mass
                    ay += thrust * thrust_dir_y / current_mass
                    az += thrust * thrust_dir_z / current_mass
                    # Mass depletion
                    dmass_dt = -mass_flow_rate
                else:
                    dmass_dt = Decimal('0')

                # Coriolis
                if coriolis:
                    omega = EARTH_ROTATION_RATE
                    lat_rad = latitude.radians()
                    ax += Decimal('2') * omega * (vy * lat_rad.sin() - vz * lat_rad.cos())
                    ay -= Decimal('2') * omega * vx * lat_rad.sin()
                    az += Decimal('2') * omega * vx * lat_rad.cos()

                # Moments
                moment_pitch = Cm * dynamic_pressure * area * diameter
                q_dot = moment_pitch / Iyy

                # Angular acceleration (simplified Euler equations)
                p_dot = (Izz - Iyy) * q * r / Ixx
                r_dot = (Iyy - Ixx) * p * q / Izz

                # Kinematic equations
                phi_dot = p + r * theta.sin() * phi.tan() + q * theta.cos() * phi.tan()
                theta_dot = q * phi.cos() - r * phi.sin()
                psi_dot = r * theta.cos() / phi.cos() + q * theta.sin() / phi.cos()

                return [vx, vy, vz, ax, ay, az, phi_dot, theta_dot, psi_dot, p_dot, q_dot, r_dot, dmass_dt]

            def rk45_step(t: Decimal, state_vec: List[Decimal], h: Decimal) -> Tuple[List[Decimal], Decimal]:
                # Butcher tableau for Fehlberg method
                c = [Decimal('0'), Decimal('1/4'), Decimal('3/8'), Decimal('12/13'), Decimal('1'), Decimal('1/2')]
                a = [
                    [],
                    [Decimal('1/4')],
                    [Decimal('3/32'), Decimal('9/32')],
                    [Decimal('1932/2197'), Decimal('-7200/2197'), Decimal('7296/2197')],
                    [Decimal('439/216'), Decimal('-8'), Decimal('3680/513'), Decimal('-845/4104')],
                    [Decimal('-8/27'), Decimal('2'), Decimal('-3544/2565'), Decimal('1859/4104'), Decimal('-11/40')]
                ]
                b4 = [Decimal('25/216'), Decimal('0'), Decimal('1408/2565'), Decimal('2197/4104'), Decimal('-1/5'), Decimal('0')]
                b5 = [Decimal('16/135'), Decimal('0'), Decimal('6656/12825'), Decimal('28561/56430'), Decimal('-9/50'), Decimal('2/55')]

                def weighted_sum(weights, k_list):
                    return [sum(w * k[i] for w, k in zip(weights, k_list)) for i in range(len(state_vec))]

                k = []
                for i in range(6):
                    if i == 0:
                        k.append([h * d for d in derivatives(t, state_vec)])
                    else:
                        temp_state = [state_vec[j] + sum(a[i-1][idx] * k[idx][j] for idx in range(i)) for j in range(len(state_vec))]
                        k.append([h * d for d in derivatives(t + c[i] * h, temp_state)])

                y4 = [state_vec[i] + weighted_sum(b4, k)[i] for i in range(len(state_vec))]
                y5 = [state_vec[i] + weighted_sum(b5, k)[i] for i in range(len(state_vec))]
                error = max(abs(y5[i] - y4[i]) for i in range(len(state_vec)))
                return y5, error

            # --- Integration Loop ---
            h = Decimal('0.01')
            safety = Decimal('0.9')
            min_step = Decimal('1e-6')
            max_step = Decimal('1.0')

            while state[1] >= get_terrain_elevation(state[0]) and time < max_time:
                new_state, error = rk45_step(time, state, h)
                if error <= tolerance:
                    state = new_state
                    time += h
                    trajectory.append(tuple(state + [time]))
                    if error > 0:
                        h_new = h * safety * (tolerance / error) ** Decimal('0.2')
                    else:
                        h_new = h * Decimal('2.0')
                    h = min(h_new, max_step)
                else:
                    h_new = h * safety * (tolerance / error) ** Decimal('0.25')
                    h = max(h_new, min_step)

            log(f"6-DOF Trajectory finished. Points: {len(trajectory)}, Final step: {h}")
            return trajectory

        except Exception as e:
            log(f"6-DOF Calculation failed: {e}", "error")
            raise

# --- Calculation Threads ---
class AdvancedCalculationThread(QThread):
    finished = pyqtSignal(object)
    error = pyqtSignal(str)

    def __init__(self, calculator: 'BallisticCalculatorTier4', params: Dict[str, Any]):
        super().__init__()
        self.calculator = calculator
        self.params = params

    def run(self):
        try:
            decimal_params = self.convert_params_to_decimal(self.params)
            result = self.calculator.advanced_calculator.calculate_trajectory_6dof(**decimal_params)
            if result:
                result = [tuple(float(v) for v in point) for point in result]
            self.finished.emit(result)
        except Exception as e:
            log(f"Advanced Calculation Thread Error: {e}", "error")
            self.error.emit(str(e))

    def convert_params_to_decimal(self, params: Dict[str, Any]) -> Dict[str, Any]:
        decimal_params = {}
        for key, value in params.items():
            if isinstance(value, (int, float)):
                decimal_params[key] = Decimal(str(value))
            elif isinstance(value, dict) and key == 'thrust_curve' and value:
                decimal_params[key] = {Decimal(str(k)): Decimal(str(v)) for k, v in value.items()}
            elif isinstance(value, list) and key == 'wind_field' and value:
                decimal_params[key] = [(Decimal(str(p[0])), Decimal(str(p[1])), Decimal(str(p[2])), Decimal(str(p[3]))) for p in value]
            elif isinstance(value, list) and key == 'terrain_profile' and value:
                decimal_params[key] = [(Decimal(str(p[0])), Decimal(str(p[1]))) for p in value]
            else:
                decimal_params[key] = value
        return decimal_params

class AdvancedBatchThread(QThread):
    finished = pyqtSignal(list)
    error = pyqtSignal(str)
    progress = pyqtSignal(int)

    def __init__(self, calculator: 'BallisticCalculatorTier4', batch_params: List[Dict[str, Any]]):
        super().__init__()
        self.calculator = calculator
        self.batch_params = batch_params

    def run(self):
        results = []
        try:
            total = len(self.batch_params)
            for i, params in enumerate(self.batch_params):
                decimal_params = self.convert_params_to_decimal(params)
                traj = self.calculator.advanced_calculator.calculate_trajectory_6dof(**decimal_params)
                if traj:
                    traj = [tuple(float(v) for v in point) for point in traj]
                results.append(traj)
                self.progress.emit(int((i + 1) / total * 100))
            self.finished.emit(results)
        except Exception as e:
            log(f"Advanced Batch Thread Error: {e}", "error")
            self.error.emit(str(e))

    def convert_params_to_decimal(self, params: Dict[str, Any]) -> Dict[str, Any]:
        decimal_params = {}
        for key, value in params.items():
            if isinstance(value, (int, float)):
                decimal_params[key] = Decimal(str(value))
            elif isinstance(value, dict) and key == 'thrust_curve' and value:
                decimal_params[key] = {Decimal(str(k)): Decimal(str(v)) for k, v in value.items()}
            elif isinstance(value, list) and key == 'wind_field' and value:
                decimal_params[key] = [(Decimal(str(p[0])), Decimal(str(p[1])), Decimal(str(p[2])), Decimal(str(p[3]))) for p in value]
            elif isinstance(value, list) and key == 'terrain_profile' and value:
                decimal_params[key] = [(Decimal(str(p[0])), Decimal(str(p[1]))) for p in value]
            else:
                decimal_params[key] = value
        return decimal_params

