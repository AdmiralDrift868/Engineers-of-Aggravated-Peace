    def calculate_advanced_trajectory(self):
        if not self.validate_advanced_inputs():
            return

        self.calculate_btn.setEnabled(False)
        self.calculate_btn.setText("Calculating...")
        self.status_bar.showMessage("Calculating 6-DOF trajectory...")

        params = {
            "mass": self.mass_input.value() / 1000,
            "diameter": self.diam_input.value() / 1000,
            "length": self.length_input.value() / 1000,
            "aerodynamic_model": self.aero_model_combo.currentText(),
            "velocity": self.velocity_input.value(),
            "launch_angle": math.radians(self.angle_input.value()),
            "launch_heading": math.radians(self.heading_input.value()),
            "spin_rate": self.spin_rate_input.value(),
            "fin_angle": self.fin_angle_input.value(),
            "thrust_vector_angle": self.thrust_vector_input.value(),
            "mass_flow_rate": self.mass_flow_input.value(),
            "burn_time": self.burn_time_input.value(),
            "thrust_curve": self.generate_thrust_curve(),
            "altitude": self.altitude_input.value(),
            "temperature": self.temp_input.value(),
            "pressure": self.pressure_input.value() * 100,
            "humidity": self.humidity_input.value() / 100.0,
            "wind_field": self.generate_wind_field(),
            "turbulence_intensity": self.turbulence_input.value(),
            "coriolis": self.coriolis_check.isChecked(),
            "latitude": math.radians(self.latitude_input.value()),
            "terrain_profile": self.get_terrain_profile() if self.terrain_enabled.isChecked() else None,
            "sensor_noise": False,
        }

        stored_params = copy.deepcopy(params)
        self.previous_trajectories.append((self.trajectory, stored_params))
        if len(self.previous_trajectories) > 5:
            self.previous_trajectories.pop(0)

        self.calc_thread = AdvancedCalculationThread(self, params)
        self.calc_thread.finished.connect(self.on_advanced_calculation_complete)
        self.calc_thread.error.connect(self.on_advanced_calculation_error)
        self.calc_thread.start()

    def on_advanced_calculation_complete(self, trajectory: Optional[List[Tuple[float, ...]]]):
        self.calculate_btn.setEnabled(True)
        self.calculate_btn.setText("Calculate 6-DOF Trajectory")
        self.trajectory = trajectory
        if not self.trajectory:
            QMessageBox.warning(self, "Warning", "Calculation completed, but no trajectory data was generated.")
            self.status_bar.showMessage("Calculation completed with no data")
            return
        self.status_bar.showMessage("6-DOF Calculation complete.")
        self.update_advanced_results()
        self.plot_trajectory()
        log("6-DOF Trajectory calculation completed successfully.")

    def on_advanced_calculation_error(self, error_msg: str):
        self.calculate_btn.setEnabled(True)
        self.calculate_btn.setText("Calculate 6-DOF Trajectory")
        self.trajectory = None
        QMessageBox.critical(self, "Error", f"Calculation failed:\n{error_msg}")
        self.status_bar.showMessage(f"Error: {error_msg}")
        log(f"6-DOF Trajectory calculation failed: {error_msg}", "error")

    def update_advanced_results(self):
        if not self.trajectory:
            self.summary_text.setPlainText("No trajectory data available")
            self.data_text.setPlainText("")
            return

        try:
            y_coords = [p[1] for p in self.trajectory]
            x_coords = [p[0] for p in self.trajectory]
            max_height = max(y_coords) if y_coords else 0.0
            max_height_idx = y_coords.index(max_height) if y_coords else 0
            distance = self.trajectory[-1][0] if self.trajectory else 0.0
            flight_time = self.trajectory[-1][-1] if self.trajectory else 0.0
            impact_velocity = math.sqrt(self.trajectory[-1][3]**2 + self.trajectory[-1][4]**2 + self.trajectory[-1][5]**2) if self.trajectory else 0.0

            summary_lines = [
                "TIER 4 INPUT SUMMARY:",
