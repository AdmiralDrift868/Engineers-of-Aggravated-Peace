    def load_presets(self) -> Dict[str, Any]:
        presets = self.default_presets.copy()
        if os.path.exists(PRESET_FILE):
            try:
                with open(PRESET_FILE, "r") as f:
                    user_presets = json.load(f)
                for name, data in user_presets.items():
                    if not isinstance(data, dict):
                        log(f"Warning: Invalid preset '{name}'. Skipping.", "warning")
                        continue
                    if "mass" in data and data.get("mass", 0) > 1000:
                        data["mass"] /= 1000
                        log(f"Converted mass for '{name}' from g to kg.", "info")
                    if "initial_mass" in data and data.get("initial_mass", 0) > 1000:
                        data["initial_mass"] /= 1000
                        log(f"Converted initial_mass for '{name}' from g to kg.", "info")
                    if "diameter" in data and data.get("diameter", 0) > 10:
                        data["diameter"] /= 1000
                        log(f"Converted diameter for '{name}' from mm to m.", "info")
                    if "length" in data and data.get("length", 0) > 100:
                        data["length"] /= 1000
                        log(f"Converted length for '{name}' from mm to m.", "info")
                presets.update(user_presets)
                log(f"Loaded {len(user_presets)} user presets.")
            except Exception as e:
                log(f"Failed to load presets: {e}", "error")
        return presets

    def save_presets(self):
        user_presets = {k: v for k, v in self.presets.items() if k not in self.default_presets}
        try:
            with open(PRESET_FILE, "w") as f:
                json.dump(user_presets, f, indent=2)
            log(f"Saved {len(user_presets)} user presets.")
        except Exception as e:
            log(f"Failed to save presets: {e}", "error")
            QMessageBox.warning(self, "Error", f"Failed to save presets: {e}")

