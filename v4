# UTILITIES
def interpolate_table(mach: float, table: Dict[float, float]) -> float:
    keys = sorted(table.keys())
    if mach <= keys[0]: return table[keys[0]]
    if mach >= keys[-1]: return table[keys[-1]]
    for i in range(len(keys) - 1):
        if keys[i] <= mach < keys[i+1]:
            x0, x1 = keys[i], keys[i+1]
            y0, y1 = table[x0], table[x1]
            return y0 + (y1 - y0) * (mach - x0) / (x1 - x0)
    return table[keys[-1]]

def speed_of_sound(temp_c: float) -> float:
    return SPEED_OF_SOUND_STD * math.sqrt(1 + temp_c / 273.15)

def isa_density(alt_m: float, temp_c: float, press_hpa: float) -> float:
    T0, p0 = 288.15, 1013.25
    lapse = -0.0065
    T = T0 + lapse * alt_m
    if T <= 0: T = 0.1
    p = p0 * (T / T0) ** (-GRAVITY / (lapse * R))
    rho = p * 100 / (R * T)
    return rho * (press_hpa / p0) * (T0 / T)

def interpolate_curve(x: float, curve: List[Tuple[float, float]]) -> float:
    if not curve: return 0.0
    curve = sorted(curve, key=lambda p: p[0])
    xs, ys = zip(*curve)
    if x <= xs[0]: return ys[0]
    if x >= xs[-1]: return ys[-1]
    for i in range(1, len(xs)):
        if x < xs[i]:
            return ys[i-1] + (ys[i] - ys[i-1]) * (x - xs[i-1]) / (xs[i] - xs[i-1])
    return ys[-1]

