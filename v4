# CALCULATION THREAD
class CalculationThread(QThread):
    finished = pyqtSignal(object)
    error = pyqtSignal(str)

    def __init__(self, calc: 'BallisticCalculator', params: dict):
        super().__init__()
        self.calc = calc
        self.params = params

    def run(self):
        try:
            res = self.calc._calculate_trajectory(**self.params)
            self.finished.emit(res)
        except Exception as e:
            self.error.emit(str(e))

