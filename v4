    # FULL TRAJECTORY
    def _calculate_trajectory(self, **kwargs):
        mass = kwargs["mass"]
        diameter = kwargs["diameter"]
        bc = kwargs["bc"]
        bc_type = kwargs["bc_type"]
        twist_rate = kwargs["twist_rate"]
        velocity = kwargs["velocity"] * (1 + kwargs["mv_temp_coeff"] * (kwargs["temperature"] - 15))
        angle = kwargs["angle"]
        sight_height = kwargs["sight_height"] / 100
        zero_range = kwargs["zero_range"]
        cant_angle = kwargs["cant"]
        altitude = kwargs["altitude"]
        temperature = kwargs["temperature"]
        pressure = kwargs["pressure"]
        humidity = kwargs["humidity"]
        wind_speed = kwargs["wind_speed"]
        wind_angle = kwargs["wind_angle"]
        coriolis = kwargs["coriolis"]
        latitude = kwargs["latitude"]
        projectile_type = kwargs["projectile_type"]
        initial_mass = kwargs.get("initial_mass")
        burn_time = kwargs.get("burn_time", 0)
        thrust_curve = kwargs.get("thrust_curve", [])

        projectile = Projectile(mass, diameter, bc, bc_type, twist_rate, velocity, projectile_type, thrust_curve, burn_time)
        if projectile_type == 'rocket' and initial_mass:
            projectile.initial_mass = initial_mass

        env = Environment(altitude, temperature, pressure, humidity, wind_speed, wind_angle, coriolis, latitude)

        angle_rad = math.radians(angle)
        cant_rad = math.radians(cant_angle)
        wind_x = env.wind_speed * math.cos(math.radians(env.wind_angle))
        wind_z = env.wind_speed * math.sin(math.radians(env.wind_angle))
        zero_angle = math.atan(sight_height / zero_range) if zero_range > 0 else 0

        state = [0.0, 0.0, 0.0,
                 velocity * math.cos(angle_rad) * math.cos(cant_rad),
                 velocity * math.sin(angle_rad),
                 velocity * math.cos(angle_rad) * math.sin(cant_rad)]

        trajectory = []
        time = 0.0

        def derivative(s, t):
            x, y, z, vx, vy, vz = s
            v = math.hypot(vx, vy, vz)
            if v <= 0: return [0]*6

            v_rel_x = vx - wind_x
            v_rel_z = vz - wind_z
            v_rel = math.hypot(v_rel_x, vy, v_rel_z)
            cd = projectile.drag_coefficient(v_rel, temperature)
            drag_force = 0.5 * env.air_density * v_rel**2 * cd * projectile.area
            mass_t = projectile.get_mass(t)
            ax = -drag_force * v_rel_x / (mass_t * v_rel) if v_rel > 0 else 0
            ay = -GRAVITY - drag_force * vy / (mass_t * v_rel) if v_rel > 0 else -GRAVITY
            az = -drag_force * v_rel_z / (mass_t * v_rel) if v_rel > 0 else 0

            if projectile_type == 'rocket' and t < burn_time:
                thrust = projectile.get_thrust(t)
                if v > 0:
                    ax += thrust * vx / v / mass_t
                    ay += thrust * vy / v / mass_t
                    az += thrust * vz / v / mass_t

            spin_rpm = projectile.spin_rpm(v)
            if spin_rpm > 0 and projectile_type == 'bullet':
                magnus = 0.5 * env.air_density * v_rel**2 * projectile.area * 0.0001
                ax += magnus * vy / v_rel / mass_t
                ay -= magnus * vx / v_rel / mass_t

            if coriolis:
                omega = EARTH_ROTATION_RATE
                lat_rad = math.radians(latitude)
                ax += 2 * omega * (vy * math.cos(lat_rad) + vz * math.sin(lat_rad))
                ay -= 2 * omega * vx * math.cos(lat_rad)
                az -= 2 * omega * vx * math.sin(lat_rad)

            return [vx, vy, vz, ax, ay, az]

        v0 = math.hypot(*state[3:6])
        los_y = sight_height + state[0] * math.tan(-zero_angle)
        drop = state[1] - los_y
        energy = 0.5 * mass * v0**2
        trajectory.append((*state, time, v0, energy, drop, 0.0, 0.0))

        while state[1] >= 0 and time < 120:
            v = math.hypot(*state[3:6])
            dt = max(0.001, min(0.1, 300 / max(50, v)))
            if state[1] + state[4] * dt < 0:
                dt = -state[1] / state[4] if state[4] < 0 else dt

            k1 = derivative(state, time)
            k2 = derivative([s + 0.5*dt*k for s, k in zip(state, k1)], time + 0.5*dt)
            k3 = derivative([s + 0.5*dt*k for s, k in zip(state, k2)], time + 0.5*dt)
            k4 = derivative([s + dt*k for s, k in zip(state, k3)], time + dt)

            for i in range(6):
                state[i] += dt/6 * (k1[i] + 2*k2[i] + 2*k3[i] + k4[i])
            time += dt

            v = math.hypot(*state[3:6])
            energy = 0.5 * projectile.get_mass(time) * v**2
            los_y = sight_height + state[0] * math.tan(-zero_angle)
            drop = state[1] - los_y
            drift = state[2]
            trajectory.append((*state, time, v, energy, drop, drift, time))

        return trajectory

    def calculate_trajectory(self):
        params = {
            "mass": self.proj_inputs[0].value(),
            "diameter": self.proj_inputs[1].value(),
            "bc": self.bc_input.value() if self.use_bc_check.isChecked() else 0,
            "bc_type": self.bc_type_combo.currentText().lower(),
            "twist_rate": self.proj_inputs[2].value(),
            "velocity": self.velocity_input.value(),
            "angle": self.angle_input.value(),
            "sight_height": self.proj_inputs[3].value(),
            "zero_range": self.proj_inputs[4].value(),
            "cant": self.proj_inputs[5].value(),
            "altitude": self.env_inputs[0].value(),
            "temperature": self.env_inputs[1].value(),
            "pressure": self.env_inputs[2].value(),
            "humidity": self.env_inputs[3].value(),
            "wind_speed": self.env_inputs[4].value(),
            "wind_angle": self.env_inputs[5].value(),
            "coriolis": self.coriolis_check.isChecked(),
            "latitude": self.latitude_input.value(),
            "projectile_type": self.type_combo.currentText().lower(),
            "mv_temp_coeff": self.mv_temp_coeff.value()
        }
        if params["projectile_type"] == "rocket":
            curve = []
            for pair in self.thrust_curve_input.text().split(','):
                if ':' in pair:
                    t, f = pair.split(':')
                    try: curve.append((float(t), float(f)))
                    except: pass
            params.update({
                "initial_mass": self.initial_mass_input.value(),
                "burn_time": self.burn_time_input.value(),
                "thrust_curve": curve
            })

        self.calc_thread = CalculationThread(self, params)
        self.calc_thread.finished.connect(self.on_calc_complete)
        self.calc_thread.error.connect(self.on_calc_error)
        self.calc_thread.start()

    def on_calc_complete(self, traj):
        self.trajectory = traj
        self.update_results()
        self.update_drop_table()
        self.plot_trajectory()

    def on_calc_error(self, msg):
        QMessageBox.critical(self, "Error", msg)

    def update_results(self):
        if not self.trajectory: return
        impact = self.trajectory[-1]
        max_h = max(p[1] for p in self.trajectory)
        text = f"""
<b>IMPACT</b><br>
Range: <b>{impact[0]:.1f} m</b><br>
Max Height: <b>{max_h:.1f} m</b><br>
TOF: <b>{impact[6]:.2f} s</b><br>
Impact Vel: <b>{impact[7]:.1f} m/s</b><br>
Energy: <b>{impact[8]:.0f} J</b><br>
Drift: <b>{impact[10]:.1f} cm</b>
        """
        self.summary_text.setHtml(text)

    def update_drop_table(self):
        if not self.trajectory: return
        self.drop_table.setRowCount(0)
        ranges = np.arange(0, int(self.trajectory[-1][0]) + 100, 100)
        for r in ranges:
            row = self.drop_table.rowCount()
            self.drop_table.insertRow(row)
            point = min(self.trajectory, key=lambda p: abs(p[0] - r))
            self.drop_table.setItem(row, 0, QTableWidgetItem(f"{point[0]:.0f}"))
            self.drop_table.setItem(row, 1, QTableWidgetItem(f"{point[9]*100:.1f}"))
            self.drop_table.setItem(row, 2, QTableWidgetItem(f"{point[10]*100:.1f}"))
            self.drop_table.setItem(row, 3, QTableWidgetItem(f"{point[7]:.1f}"))
            self.drop_table.setItem(row, 4, QTableWidgetItem(f"{point[8]:.0f}"))
            self.drop_table.setItem(row, 5, QTableWidgetItem(f"{point[6]:.2f}"))
            moa = math.degrees(math.atan(point[9]/point[0])) * 60 if point[0] > 0 else 0
            self.drop_table.setItem(row, 6, QTableWidgetItem(f"{moa:.2f}"))

    def plot_trajectory(self):
        self.figure.clear()
        ax = self.figure.add_subplot(111, projection='3d')
        if self.trajectory:
            x = [p[0] for p in self.trajectory]
            y = [p[1] for p in self.trajectory]
            z = [p[2] for p in self.trajectory]
            ax.plot(x, z, y, 'b-', label='Current')
        if self.compare_check.isChecked():
            for traj, _ in self.previous_trajectories:
                x = [p[0] for p in traj]
                y = [p[1] for p in traj]
                z = [p[2] for p in traj]
                ax.plot(x, z, y, '--', alpha=0.5)
        ax.set_xlabel('Range (m)'); ax.set_ylabel('Drift (m)'); ax.set_zlabel('Height (m)')
        ax.legend()
        self.canvas.draw()

    def export_to_csv(self):
        if not self.trajectory: return
        filename, _ = QFileDialog.getSaveFileName(self, "Export", "", "CSV (*.csv)")
        if filename:
            with open(filename, 'w', newline='') as f:
                writer = csv.writer(f)
                writer.writerow(["Time", "X", "Y", "Z", "Vx", "Vy", "Vz", "V", "Energy", "Drop", "Drift"])
                for p in self.trajectory:
                    writer.writerow([f"{v:.6f}" for v in p[6:] + p[:6]])

    def export_plot_to_png(self):
        filename, _ = QFileDialog.getSaveFileName(self, "Export Plot", "", "PNG (*.png)")
        if filename:
            self.figure.savefig(filename, dpi=300)

    def run_batch(self):
        if not self.trajectory:
            QMessageBox.warning(self, "No Data", "Calculate a trajectory first.")
            return

        param = self.batch_param.currentText().lower()
        start = self.batch_start.value()
        end = self.batch_end.value()
        step = self.batch_step.value()
        values = np.arange(start, end + step, step)

        self.batch_table.setRowCount(0)
        self.batch_table.setColumnCount(len(values) + 1)
        self.batch_table.setHorizontalHeaderLabels(["Range (m)"] + [f"{v:.1f}" for v in values])
        self.batch_progress.setMaximum(len(values))

        results = {}
        base_params = {
            "mass": self.proj_inputs[0].value(),
            "diameter": self.proj_inputs[1].value(),
            "bc": self.bc_input.value() if self.use_bc_check.isChecked() else 0,
            "bc_type": self.bc_type_combo.currentText().lower(),
            "twist_rate": self.proj_inputs[2].value(),
            "velocity": self.velocity_input.value(),
            "angle": self.angle_input.value(),
            "sight_height": self.proj_inputs[3].value(),
            "zero_range": self.proj_inputs[4].value(),
            "cant": self.proj_inputs[5].value(),
            "altitude": self.env_inputs[0].value(),
            "temperature": self.env_inputs[1].value(),
            "pressure": self.env_inputs[2].value(),
            "humidity": self.env_inputs[3].value(),
            "wind_speed": self.env_inputs[4].value(),
            "wind_angle": self.env_inputs[5].value(),
            "coriolis": self.coriolis_check.isChecked(),
            "latitude": self.latitude_input.value(),
            "projectile_type": self.type_combo.currentText().lower(),
            "mv_temp_coeff": self.mv_temp_coeff.value()
        }

        for i, val in enumerate(values):
            params = base_params.copy()
            if param == "angle":
                params["angle"] = val
            elif param == "velocity":
                params["velocity"] = val
            elif param == "wind":
                params["wind_speed"] = val

            if params["projectile_type"] == "rocket":
                curve = []
                for pair in self.thrust_curve_input.text().split(','):
                    if ':' in pair:
                        t, f = pair.split(':')
                        try: curve.append((float(t), float(f)))
                        except: pass
                params.update({
                    "initial_mass": self.initial_mass_input.value(),
                    "burn_time": self.burn_time_input.value(),
                    "thrust_curve": curve
                })

            traj = self._calculate_trajectory(**params)
            impact_range = traj[-1][0]
            results[val] = impact_range
            self.batch_progress.setValue(i + 1)

        # Fill table
        max_range = max(results.values())
        ranges = np.arange(0, int(max_range) + 100, 100)
        for r in ranges:
            row = self.batch_table.rowCount()
            self.batch_table.insertRow(row)
            self.batch_table.setItem(row, 0, QTableWidgetItem(f"{r:.0f}"))
            for col, val in enumerate(values, 1):
                # Find closest point
                params = base_params.copy()
                if param == "angle": params["angle"] = val
                elif param == "velocity": params["velocity"] = val
                elif param == "wind": params["wind_speed"] = val
                if params["projectile_type"] == "rocket":
                    curve = []
                    for pair in self.thrust_curve_input.text().split(','):
                        if ':' in pair:
                            t, f = pair.split(':')
                            try: curve.append((float(t), float(f)))
                            except: pass
                    params.update({"initial_mass": self.initial_mass_input.value(), "burn_time": self.burn_time_input.value(), "thrust_curve": curve})
                traj = self._calculate_trajectory(**params)
                point = min(traj, key=lambda p: abs(p[0] - r))
                drop_cm = point[9] * 100
                self.batch_table.setItem(row, col, QTableWidgetItem(f"{drop_cm:.1f}"))

    def run_monte_carlo(self):
        if not self.trajectory:
            QMessageBox.warning(self, "No Data", "Calculate a trajectory first.")
            return

        runs = self.mc_runs.value()
        angle_std = self.mc_angle.value()
        vel_std = self.mc_vel.value()

        base_params = {
            "mass": self.proj_inputs[0].value(),
            "diameter": self.proj_inputs[1].value(),
            "bc": self.bc_input.value() if self.use_bc_check.isChecked() else 0,
            "bc_type": self.bc_type_combo.currentText().lower(),
            "twist_rate": self.proj_inputs[2].value(),
            "velocity": self.velocity_input.value(),
            "angle": self.angle_input.value(),
            "sight_height": self.proj_inputs[3].value(),
            "zero_range": self.proj_inputs[4].value(),
            "cant": self.proj_inputs[5].value(),
            "altitude": self.env_inputs[0].value(),
            "temperature": self.env_inputs[1].value(),
            "pressure": self.env_inputs[2].value(),
            "humidity": self.env_inputs[3].value(),
            "wind_speed": self.env_inputs[4].value(),
            "wind_angle": self.env_inputs[5].value(),
            "coriolis": self.coriolis_check.isChecked(),
            "latitude": self.latitude_input.value(),
            "projectile_type": self.type_combo.currentText().lower(),
            "mv_temp_coeff": self.mv_temp_coeff.value()
        }

        impacts = []
        self.mc_progress.setMaximum(runs)
        for i in range(runs):
            params = base_params.copy()
            params["angle"] += random.gauss(0, angle_std)
            params["velocity"] += random.gauss(0, vel_std)
            if params["projectile_type"] == "rocket":
                curve = []
                for pair in self.thrust_curve_input.text().split(','):
                    if ':' in pair:
                        t, f = pair.split(':')
                        try: curve.append((float(t), float(f)))
                        except: pass
                params.update({"initial_mass": self.initial_mass_input.value(), "burn_time": self.burn_time_input.value(), "thrust_curve": curve})
            traj = self._calculate_trajectory(**params)
            impact = traj[-1]
            impacts.append((impact[0], impact[2] * 100))  # range, drift_cm
            self.mc_progress.setValue(i + 1)

        # Plot
        self.mc_figure.clear()
        ax = self.mc_figure.add_subplot(111)
        x, z = zip(*impacts)
        ax.hist2d(x, z, bins=30, cmap='plasma')
        ax.set_xlabel('Range (m)')
        ax.set_ylabel('Drift (cm)')
        ax.set_title(f'Monte Carlo: {runs} Runs')
        self.mc_canvas.draw()

