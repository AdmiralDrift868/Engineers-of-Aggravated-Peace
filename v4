# PROJECTILE
class Projectile:
    def __init__(self, mass: float, diameter: float, bc: float, bc_type: str, twist_rate: float,
                 velocity: float, projectile_type: str, thrust_curve=None, burn_time=0,
                 custom_drag_curve=None):
        self.mass = mass
        self.diameter = diameter / 1000
        self.bc = bc
        self.bc_type = bc_type.lower()
        self.twist_rate = twist_rate
        self.velocity = velocity
        self.area = math.pi * (self.diameter / 2) ** 2
        self.projectile_type = projectile_type.lower()
        self.thrust_curve = thrust_curve or []
        self.burn_time = burn_time
        self.initial_mass = mass
        self.custom_drag_curve = custom_drag_curve

    def sectional_density(self) -> float:
        return self.mass / (self.diameter ** 2)

    def drag_coefficient(self, v: float, temp_c: float) -> float:
        mach = v / speed_of_sound(temp_c)
        if self.bc > 0:
            sd = self.sectional_density()
            if sd <= 0: return 0.3
            table = CD_TABLE_G1 if self.bc_type == 'g1' else CD_TABLE_G7
            cd_std = interpolate_table(mach, table)
            return cd_std / (self.bc * sd)
        elif self.custom_drag_curve:
            return interpolate_curve(v, self.custom_drag_curve)
        return 0.3

    def get_thrust(self, t: float) -> float:
        if self.projectile_type != 'rocket' or t > self.burn_time or not self.thrust_curve:
            return 0.0
        return interpolate_curve(t, self.thrust_curve)

    def get_mass(self, t: float) -> float:
        if self.projectile_type != 'rocket' or t > self.burn_time or self.burn_time <= 0:
            return self.mass
        frac = t / self.burn_time
        return self.initial_mass - (self.initial_mass - self.mass) * frac

    def spin_rpm(self, velocity: float) -> float:
        if self.twist_rate <= 0: return 0
        return (velocity * 39.3701) / self.twist_rate * 60

