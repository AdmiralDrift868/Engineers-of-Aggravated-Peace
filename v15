                with open(filename, 'r', newline='') as csvfile:
                    # Attempt to detect delimiter (comma or semicolon)
                    sample = csvfile.read(1024)
                    csvfile.seek(0)
                    sniffer = csv.Sniffer()
                    delimiter = sniffer.sniff(sample).delimiter

                    reader = csv.reader(csvfile, delimiter=delimiter)
                    header = next(reader) # Read header row
                    # Assume header is like ['Mach', 'Cd'] or ['Velocity (m/s)', 'Cd']
                    # We'll try to parse the first column as a float (Mach or Velocity)
                    for row in reader:
                        if len(row) >= 2:
                            try:
                                # Parse key (Mach or velocity) and value (Cd)
                                key = float(row[0])
                                value = float(row[1])
                                cd_data[key] = value
