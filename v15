        if self.velocity_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Muzzle velocity must be positive")
            return False
        if self.type_combo.currentText().lower() == 'rocket':
            initial_mass_g = self.initial_mass_input.value()
            final_mass_g = self.mass_input.value()
            if initial_mass_g < final_mass_g:
                QMessageBox.warning(self, "Invalid Input", "Initial mass must be greater than or equal to final mass for rockets.")
                return False
            if self.burn_time_input.value() <= 0 and self.thrust_input.value() > 0:
                 QMessageBox.warning(self, "Invalid Input", "Burn time must be positive if thrust is specified for rockets.")
                 return False
        if self.pressure_input.value() <= 0:
             QMessageBox.warning(self, "Invalid Input", "Pressure must be positive")
