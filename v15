    def refresh_preset_combo(self):
        self.preset_combo.blockSignals(True) # Prevent triggering load_preset
        self.preset_combo.clear()
        self.preset_combo.addItems(sorted(self.presets.keys()))
        self.preset_combo.blockSignals(False)

    def load_preset(self, preset_name: str):
        if preset_name in self.presets:
            preset_data = self.presets[preset_name]
            self.type_combo.setCurrentText(preset_data.get("type", "bullet"))
            self.mass_input.setValue(preset_data.get("mass", 10) * 1000) # Convert kg to g
            self.initial_mass_input.setValue(preset_data.get("initial_mass", self.mass_input.value()) * 1000) # Convert kg to g
            self.diam_input.setValue(preset_data.get("diameter", 10) * 1000) # Convert m to mm
            self.drag_model_combo.setCurrentText(preset_data.get("drag_model", "G1"))
            self.burn_time_input.setValue(preset_data.get("burn_time", 0))
            self.thrust_input.setValue(preset_data.get("thrust", 0))

    def save_current_as_preset(self):
        preset_name, ok = QInputDialog.getText(self, "Save Preset", "Enter preset name:")
        if ok and preset_name:
            if preset_name in self.default_presets:
                 QMessageBox.warning(self, "Invalid Name", "Cannot overwrite a default preset. Choose a different name.")
                 return
            # Convert g/mm back to kg/m for storage
            preset_data = {
                "type": self.type_combo.currentText(),
                "mass": self.mass_input.value() / 1000, # g to kg
                "initial_mass": self.initial_mass_input.value() / 1000, # g to kg
                "diameter": self.diam_input.value() / 1000, # mm to m
                "drag_model": self.drag_model_combo.currentText(),
                "burn_time": self.burn_time_input.value(),
                "thrust": self.thrust_input.value()
            }
            self.presets[preset_name] = preset_data
            self.save_presets()
            self.refresh_preset_combo()
            self.preset_combo.setCurrentText(preset_name) # Select the new preset
            self.status_bar.showMessage(f"Preset '{preset_name}' saved.")

    def delete_selected_preset(self):
        preset_name = self.preset_combo.currentText()
        if preset_name in self.default_presets:
             QMessageBox.warning(self, "Invalid Action", "Cannot delete a default preset.")
             return
        if preset_name in self.presets:
            reply = QMessageBox.question(self, 'Delete Preset', f"Are you sure you want to delete preset '{preset_name}'?",
                                        QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
            if reply == QMessageBox.Yes:
                del self.presets[preset_name]
                self.save_presets()
                self.refresh_preset_combo()
                self.status_bar.showMessage(f"Preset '{preset_name}' deleted.")

    def on_projectile_type_changed(self, ptype: str):
         is_rocket = (ptype.lower() == 'rocket')
         self.initial_mass_input.setEnabled(is_rocket)
         self.burn_time_input.setEnabled(is_rocket)
         self.thrust_input.setEnabled(is_rocket)
         if not is_rocket:
             # Reset rocket fields if not rocket
             self.initial_mass_input.setValue(self.mass_input.value())
             self.burn_time_input.setValue(0)
             self.thrust_input.setValue(0)

    def on_coriolis_changed(self, state):
        self.latitude_input.setEnabled(state == Qt.Checked)

    def calculate_trajectory(self):
        if not self.validate_inputs():
            return

        self.calculate_btn.setEnabled(False)
        self.calculate_btn.setText("Calculating...")
        self.status_bar.showMessage("Calculating trajectory...")

        # Prepare parameters (convert units)
        params = {
            "mass": self.mass_input.value() / 1000,  # g to kg
            "diameter": self.diam_input.value() / 1000,  # mm to m
            "drag_model": self.drag_model_combo.currentText(),
            "velocity": self.velocity_input.value(),
            "angle": math.radians(self.angle_input.value()), # Convert to radians
            "altitude": self.altitude_input.value(),
            "temperature": self.temp_input.value(),
            "pressure": self.pressure_input.value() * 100,  # hPa to Pa
            "humidity": self.humidity_input.value() / 100.0, # % to fraction
            "wind_speed": self.wind_speed_input.value(),
            "wind_angle": math.radians(self.wind_angle_input.value()), # Convert to radians
            "coriolis": self.coriolis_check.isChecked(),
            "latitude": math.radians(self.latitude_input.value()), # Convert to radians
            "projectile_type": self.type_combo.currentText(),
            "initial_mass": self.initial_mass_input.value() / 1000, # g to kg
            "burn_time": self.burn_time_input.value(),
            "thrust_curve": None # Simplified, could be loaded from file
        }

        # Store parameters for potential comparison
        stored_params = copy.deepcopy(params)
        self.previous_trajectories.append((self.trajectory, stored_params))
        if len(self.previous_trajectories) > 5:  # Keep last 5
            self.previous_trajectories.pop(0)

        # Create and start thread
        self.calc_thread = CalculationThread(self, params)
        self.calc_thread.finished.connect(self.on_calculation_complete)
        self.calc_thread.error.connect(self.on_calculation_error)
        self.calc_thread.start()

    def on_calculation_complete(self, trajectory: Optional[List[Tuple[float, float, float, float, float, float]]]):
        self.calculate_btn.setEnabled(True)
        self.calculate_btn.setText("Calculate Trajectory")
        self.trajectory = trajectory

        if self.trajectory is None or len(self.trajectory) == 0:
            QMessageBox.warning(self, "Warning", "Calculation completed, but no trajectory data was generated (e.g., projectile impacted immediately).")
            self.status_bar.showMessage("Calculation completed with no data")
            log("Trajectory calculation completed, but generated no data points.")
            self.summary_text.setPlainText("No trajectory data available.")
            self.data_text.setPlainText("")
            self.plot_trajectory() # Clear plot
            return

        self.status_bar.showMessage("Calculation complete.")
        self.update_results()
        self.plot_trajectory()
        log("Trajectory calculation completed successfully.")

    def on_calculation_error(self, error_msg: str):
        self.calculate_btn.setEnabled(True)
        self.calculate_btn.setText("Calculate Trajectory")
        self.trajectory = None
        self.summary_text.setPlainText(f"Error during calculation:\n{error_msg}")
        self.data_text.setPlainText("")
        self.plot_trajectory()  # Clear plot on error
        QMessageBox.critical(self, "Error", f"Calculation failed:\n{error_msg}")
        self.status_bar.showMessage(f"Error: {error_msg}")
        log(f"Trajectory calculation failed: {error_msg}", "error")

    def update_results(self):
        if not self.trajectory or len(self.trajectory) == 0:
            self.summary_text.setPlainText("No trajectory data available")
            self.data_text.setPlainText("")
            return

        try:
            # --- Summary ---
            y_coords = [p[1] for p in self.trajectory]
            x_coords = [p[0] for p in self.trajectory]
            max_height = max(y_coords) if y_coords else 0.0
            max_height_idx = y_coords.index(max_height) if y_coords else 0
            distance = self.trajectory[-1][0] if self.trajectory else 0.0
            flight_time = self.trajectory[-1][2] if self.trajectory else 0.0
            impact_velocity = self.trajectory[-1][5] if self.trajectory else 0.0
            impact_vx = self.trajectory[-1][3] if self.trajectory else 0.0
            impact_vy = self.trajectory[-1][4] if self.trajectory else 0.0
            impact_angle_rad = math.atan2(impact_vy, impact_vx) if (impact_vx != 0 or impact_vy != 0) else 0
            impact_angle_deg = math.degrees(impact_angle_rad)
            mass_kg = self.mass_input.value() / 1000 # Convert g to kg for energy calc
            impact_energy = 0.5 * mass_kg * impact_velocity**2 if impact_velocity else 0.0

            summary_lines = [
                "INPUT SUMMARY:",
                f" Projectile Type: {self.type_combo.currentText().title()}",
                f" Preset: {self.preset_combo.currentText()}",
                f" Mass: {self.mass_input.value():.2f} g",
                f" Diameter: {self.diam_input.value():.2f} mm",
                f" Drag Model: {self.drag_model_combo.currentText()}",
                f" Muzzle Velocity: {self.velocity_input.value():.2f} m/s",
                f" Launch Angle: {self.angle_input.value():.2f}°",
            ]
            if self.type_combo.currentText().lower() == 'rocket':
                summary_lines.extend([
                    f" Burn Time: {self.burn_time_input.value():.2f} s",
                    f" Avg Thrust: {self.thrust_input.value():.0f} N",
                    f" Initial Mass: {self.initial_mass_input.value():.2f} g",
                ])
            summary_lines.extend([
                "",
                "ENVIRONMENT:",
                f" Altitude: {self.altitude_input.value():.1f} m",
                f" Temperature: {self.temp_input.value():.1f} °C",
                f" Pressure: {self.pressure_input.value():.2f} hPa",
                f" Humidity: {self.humidity_input.value():.0f} %",
                f" Wind Speed: {self.wind_speed_input.value():.1f} m/s",
                f" Wind Angle: {self.wind_angle_input.value()}°",
                f" Coriolis Effect: {'On' if self.coriolis_check.isChecked() else 'Off'}",
            ])
            if self.coriolis_check.isChecked():
                summary_lines.append(f" Latitude: {self.latitude_input.value():.2f}°")
            summary_lines.extend([
                "",
                "RESULTS:",
                f" Maximum Height: {max_height:.2f} m (at {self.trajectory[max_height_idx][0]:.2f} m downrange)",
                f" Total Distance: {distance:.2f} m",
                f" Flight Time: {flight_time:.3f} s",
                f" Impact Velocity: {impact_velocity:.2f} m/s",
                f" Impact Angle: {impact_angle_deg:.2f}°",
                f" Impact Energy: {impact_energy:.2f} J",
            ])
            self.summary_text.setPlainText("\n".join(summary_lines))

            # --- Detailed Data ---
            # Update detailed data table-style in text
            data_header = f"{'Time (s)':<10} {'X (m)':<12} {'Y (m)':<12} {'Vx (m/s)':<12} {'Vy (m/s)':<12} {'V (m/s)':<12}"
            data_lines = [data_header]
            data_lines.append("-" * len(data_header))

            # Show every Nth point or a fixed number of points for readability
            num_points = len(self.trajectory)
            step = max(1, num_points // 50)  # Show max 50 points
            for i in range(0, num_points, step):
                point = self.trajectory[i]
                data_lines.append(f"{point[2]:<10.3f} {point[0]:<12.2f} {point[1]:<12.2f} "
                                  f"{point[3]:<12.2f} {point[4]:<12.2f} {point[5]:<12.2f}")

            # Always include the last point (impact)
            if num_points > 0 and (num_points - 1) % step != 0:
                point = self.trajectory[-1]
                data_lines.append(f"{point[2]:<10.3f} {point[0]:<12.2f} {point[1]:<12.2f} "
                                  f"{point[3]:<12.2f} {point[4]:<12.2f} {point[5]:<12.2f}")

            self.data_text.setPlainText('\n'.join(data_lines))

            # Scroll results to top
            self.summary_text.moveCursor(QTextCursor.Start)
            self.data_text.moveCursor(QTextCursor.Start)

        except Exception as e:
            error_msg = f"Error updating results display: {e}"
            log(error_msg, "error")
            self.summary_text.setPlainText(error_msg)
            self.data_text.setPlainText("")

    def plot_trajectory(self):
        if not MATPLOTLIB_AVAILABLE:
            return # Shouldn't happen if tabs are created correctly, but be safe

        try:
            self.figure.clear()
            ax = self.figure.add_subplot(111)

            if self.trajectory and len(self.trajectory) > 1:
                x = [p[0] for p in self.trajectory]
                y = [p[1] for p in self.trajectory]
                ax.plot(x, y, label="Current Trajectory", marker='o', markersize=2)

            # Plot previous trajectories if checkbox is checked
            if self.compare_check.isChecked():
                for i, (prev_traj, _) in enumerate(self.previous_trajectories):
                    if prev_traj and len(prev_traj) > 1:
                         px = [p[0] for p in prev_traj]
                         py = [p[1] for p in prev_traj]
                         ax.plot(px, py, linestyle='--', alpha=0.7, label=f"Previous Run {i+1}")

            ax.set_title('Projectile Trajectory')
            ax.set_xlabel('Distance (m)')
            ax.set_ylabel('Height (m)')
            ax.grid(True, alpha=0.3)
            if self.trajectory or (self.compare_check.isChecked() and self.previous_trajectories):
                ax.legend()
            self.canvas.draw()

        except Exception as e:
            log(f"Error plotting trajectory: {e}", "error")
            # Don't show a popup here as it might interfere with the main calculation flow

    def run_batch(self):
        if not MATPLOTLIB_AVAILABLE:
            QMessageBox.warning(self, "Warning", "Matplotlib is not installed. Batch plotting is disabled.")
            return

        try:
            start = self.batch_start_input.value()
            end = self.batch_end_input.value()
            step = self.batch_step_input.value()
            param_to_sweep = self.batch_param_combo.currentText().lower().replace(" ", "_")

            if step <= 0:
                QMessageBox.warning(self, "Invalid Input", "Step size must be positive.")
                return
            if start > end:
                QMessageBox.warning(self, "Invalid Input", "Start value must be less than or equal to End value.")
                return

            # Get base parameters
            base_params = {
                "mass": self.mass_input.value() / 1000,
                "diameter": self.diam_input.value() / 1000,
                "drag_model": self.drag_model_combo.currentText(),
                "velocity": self.velocity_input.value(),
                "angle": math.radians(self.angle_input.value()),
                "altitude": self.altitude_input.value(),
                "temperature": self.temp_input.value(),
                "pressure": self.pressure_input.value() * 100,
                "humidity": self.humidity_input.value() / 100.0,
                "wind_speed": self.wind_speed_input.value(),
                "wind_angle": math.radians(self.wind_angle_input.value()),
                "coriolis": self.coriolis_check.isChecked(),
                "latitude": math.radians(self.latitude_input.value()),
                "projectile_type": self.type_combo.currentText(),
                "initial_mass": self.initial_mass_input.value() / 1000,
                "burn_time": self.burn_time_input.value(),
                "thrust_curve": None
            }

            # Generate batch parameters
            batch_params = []
            current_val = start
            while current_val <= end:
                params = base_params.copy()
                if param_to_sweep == "angle":
                    params["angle"] = math.radians(current_val)
                elif param_to_sweep == "muzzle_velocity":
                    params["velocity"] = current_val
                else:
                    raise ValueError(f"Unknown batch parameter: {param_to_sweep}")
                batch_params.append(params)
                current_val += step

            if not batch_params:
                 QMessageBox.warning(self, "Warning", "No batch parameters generated. Check start/end/step values.")
                 return

            self.batch_run_btn.setEnabled(False)
            self.batch_progress_bar.setValue(0)
            self.batch_table.setRowCount(0)
            self.status_bar.showMessage("Running batch calculations...")

            # Create and start batch thread
            self.batch_thread = BatchCalculationThread(self, batch_params)
            self.batch_thread.finished.connect(self.on_batch_complete)
            self.batch_thread.error.connect(self.on_batch_error)
            self.batch_thread.progress.connect(self.batch_progress_bar.setValue)
            self.batch_thread.start()

        except Exception as e:
            error_msg = f"Error setting up batch run: {e}"
            log(error_msg, "error")
            QMessageBox.critical(self, "Batch Error", error_msg)
            self.status_bar.showMessage("Batch setup error.")

    def on_batch_complete(self, results: List[Optional[List]]):
        self.batch_run_btn.setEnabled(True)
        self.status_bar.showMessage("Batch calculations complete.")
        log("Batch calculations completed.")

        try:
            if not results:
                 self.batch_table.setRowCount(0)
                 QMessageBox.information(self, "Batch Complete", "Batch run finished, but no results were generated.")
                 return

            num_runs = len(results)
            self.batch_trajectories = results # Store for potential later use
            self.batch_table.setRowCount(num_runs)

            # Populate table
            for i, traj in enumerate(results):
                # Get parameter value for this run (assume it's linear sweep)
                # A more robust way would be to pass the value in the params dict
                param_val = self.batch_start_input.value() + i * self.batch_step_input.value()
                param_str = f"{param_val:.3f}" # Adjust decimals as needed

                max_height = distance = impact_velocity = 0.0
                if traj is not None and len(traj) > 0:
                    try:
                        y_coords = [p[1] for p in traj]
                        max_height = max(y_coords) if y_coords else 0.0
                        distance = traj[-1][0]
                        impact_velocity = traj[-1][5]
                    except (IndexError, ValueError, TypeError) as e:
                        log(f"Error processing batch result {i}: {e}", "warning")
                        max_height = distance = impact_velocity = 0.0
                        param_str += " (Error)"
                else:
                     max_height = distance = impact_velocity = 0.0
                     param_str += " (No Data)"

                # Create items
                items = [
                    QTableWidgetItem(str(i + 1)),
                    QTableWidgetItem(param_str),
                    QTableWidgetItem(f"{max_height:.2f}"),
                    QTableWidgetItem(f"{distance:.2f}"),
                    QTableWidgetItem(f"{impact_velocity:.2f}")
                ]
                for j, item in enumerate(items):
                    self.batch_table.setItem(i, j, item)

            self.batch_table.resizeColumnsToContents()
            QMessageBox.information(self, "Batch Complete", f"Batch run finished. {num_runs} simulations completed.")

        except Exception as e:
            error_msg = f"Error processing batch results: {e}"
            log(error_msg, "error")
            QMessageBox.critical(self, "Batch Error", error_msg)
            self.status_bar.showMessage("Batch error during result processing.")

    def on_batch_error(self, error_msg: str):
        self.batch_run_btn.setEnabled(True)
        QMessageBox.critical(self, "Batch Error", f"Error during batch calculation:\n{error_msg}")
        self.status_bar.showMessage(f"Batch error: {error_msg}")
        log(f"Batch calculation error: {error_msg}", "error")
        # Reset UI elements
        self.batch_progress_bar.setValue(0)
        self.batch_table.setRowCount(0)

    def run_monte_carlo(self):
        if not MATPLOTLIB_AVAILABLE:
            QMessageBox.warning(self, "Warning", "Matplotlib is not installed. Monte Carlo plotting is disabled.")
            return

        try:
            num_runs = self.mc_runs_input.value()
            angle_spread = math.radians(self.mc_angle_spread_input.value()) # Convert to radians
            vel_spread = self.mc_vel_spread_input.value()

            if num_runs <= 0:
                QMessageBox.warning(self, "Invalid Input", "Number of runs must be positive.")
                return

            self.mc_run_btn.setEnabled(False)
            self.mc_progress_bar.setValue(0)
            self.status_bar.showMessage("Running Monte Carlo simulations...")

            # Get base parameters
            base_params = {
                "mass": self.mass_input.value() / 1000,
                "diameter": self.diam_input.value() / 1000,
                "drag_model": self.drag_model_combo.currentText(),
                "velocity": self.velocity_input.value(),
                "angle": math.radians(self.angle_input.value()),
                "altitude": self.altitude_input.value(),
                "temperature": self.temp_input.value(),
                "pressure": self.pressure_input.value() * 100,
                "humidity": self.humidity_input.value() / 100.0,
                "wind_speed": self.wind_speed_input.value(),
                "wind_angle": math.radians(self.wind_angle_input.value()),
                "coriolis": self.coriolis_check.isChecked(),
                "latitude": math.radians(self.latitude_input.value()),
                "projectile_type": self.type_combo.currentText(),
                "initial_mass": self.initial_mass_input.value() / 1000,
                "burn_time": self.burn_time_input.value(),
                "thrust_curve": None
            }

            self.mc_figure.clear()
            ax = self.mc_figure.add_subplot(111)
            successful_runs = 0

            for i in range(num_runs):
                # Perturb parameters
                params = base_params.copy()
                params["angle"] += random.uniform(-angle_spread, angle_spread)
                params["velocity"] += random.uniform(-vel_spread, vel_spread)
                # Clamp angle to realistic values to prevent errors
                params["angle"] = clamp(params["angle"], math.radians(0.1), math.radians(89.9))

                # Calculate trajectory
                try:
                    traj = self._calculate_trajectory(**params)
                    if traj is not None and len(traj) > 1:
                        x = [p[0] for p in traj]
                        y = [p[1] for p in traj]
                        ax.plot(x, y, color="blue", alpha=0.1, linewidth=0.5)
                        successful_runs += 1
                except Exception as e:
                    log(f"MC Run {i+1} failed: {e}", "warning")
                    # Continue with other runs

                # Update progress
                progress_percent = int((i + 1) / num_runs * 100)
                self.mc_progress_bar.setValue(progress_percent)
                # Allow UI to update periodically
                if i % 10 == 0:
                    QApplication.processEvents()

            ax.set_title(f'Monte Carlo Trajectory Spread ({successful_runs}/{num_runs} successful)')
            ax.set_xlabel('Distance (m)')
            ax.set_ylabel('Height (m)')
            ax.grid(True, alpha=0.3)
            self.mc_canvas.draw()

            self.mc_run_btn.setEnabled(True)
            self.status_bar.showMessage(f"Monte Carlo complete: {num_runs} simulations ({successful_runs} successful).")
            log(f"Monte Carlo simulation completed: {num_runs} runs ({successful_runs} successful).")

        except Exception as e:
             self.mc_run_btn.setEnabled(True)
