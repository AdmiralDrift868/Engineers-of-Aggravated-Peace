    def _calculate_trajectory(self, mass: float, diameter: float, drag_model: str, velocity: float, angle: float,
                              altitude: float, temperature: float, pressure: float, humidity: float,
                              wind_speed: float, wind_angle: float, coriolis: bool, latitude: float,
                              projectile_type: str = 'bullet',
                              initial_mass: Optional[float] = None,
                              burn_time: float = 0,
                              thrust_curve: Optional[Dict[float, float]] = None,
                              max_time: float = 200.0, dt: float = 0.01) -> List[Tuple[float, float, float, float, float, float]]:
        """Internal trajectory calculation using RK4."""
        try:
            # --- Initial Conditions ---
            x = 0.0
            y = altitude
            vx = velocity * math.cos(angle)
            vy = velocity * math.sin(angle)
            time = 0.0

            # Wind components
            wind_vx = wind_speed * math.sin(wind_angle) # Wind angle 0=N, 90=E
            wind_vy = wind_speed * math.cos(wind_angle)

            # Area
            area = math.pi * (diameter / 2) ** 2

            # Initial state vector [x, y, vx, vy]
            state = [x, y, vx, vy]

            # Trajectory storage (x, y, time, vx, vy, speed)
            trajectory = [(x, y, time, vx, vy, velocity)]

            # --- Helper Functions ---
            def get_air_density(alt: float) -> float:
                """Approximate air density using simplified ISA model."""
                try:
                    # Standard values
                    sea_level_pressure = 101325  # Pa
                    sea_level_temp = 288.15  # K (15°C)
                    lapse_rate = 0.0065  # K/m
                    gas_constant = 287.05  # J/(kg*K)

                    # Calculate temperature at altitude
                    temp_at_alt = sea_level_temp - lapse_rate * alt
                    temp_at_alt = max(temp_at_alt, 100) # Prevent negative temps

                    # Calculate pressure at altitude
                    pressure_at_alt = sea_level_pressure * (1 - (lapse_rate * alt) / sea_level_temp) ** (GRAVITY / (lapse_rate * gas_constant))

                    # Calculate base density
                    density_base = pressure_at_alt / (gas_constant * temp_at_alt)

                    # Humidity correction (simplified Buck equation for water vapor pressure)
                    svp = 611.21 * math.exp((18.678 - (temp_at_alt - 273.15) / 234.5) * ((temp_at_alt - 273.15) / (257.14 + (temp_at_alt - 273.15))))
                    pv = humidity * svp
                    pd = pressure_at_alt - pv # Partial pressure of dry air
                    density_dry = pd / (287.058 * temp_at_alt)
                    density_water_vapor = pv / (461.495 * temp_at_alt) # R for water vapor
                    density_total = density_dry + density_water_vapor

                    # Exponential decrease with altitude (alternative/combined model)
                    # This is an approximation. More accurate models exist (e.g., ISA).
                    scale_height = 8500  # Approximate scale height for density in meters
                    density_total *= math.exp(-alt / scale_height)
                    return density_total
                except Exception as e:
                    log(f"Error calculating air density: {e}. Using fallback value.", "error")
                    return 1.225  # Fallback to standard sea level density

            @lru_cache(maxsize=128)
            def get_drag_coefficient(mach: float, model: str) -> float:
                """Get drag coefficient based on Mach number and model."""
                try:
                    if model not in DRAG_MODELS:
                        log(f"Warning: Drag model '{model}' not found. Using G1.", "warning")
                        model = "G1"

                    cd_data = DRAG_MODELS[model]["cd_data"]
                    machs = sorted(cd_data.keys())

                    if not machs:
                        return 0.3 # Fallback

                    if mach <= machs[0]:
                        return cd_data[machs[0]]
                    if mach >= machs[-1]:
                        return cd_data[machs[-1]]

                    # Linear interpolation
                    for i in range(1, len(machs)):
                        if mach <= machs[i]:
                            m0, m1 = machs[i-1], machs[i]
                            cd0, cd1 = cd_data[m0], cd_data[m1]
                            return linear_interpolate(mach, m0, m1, cd0, cd1)
                    return cd_data[machs[-1]] # Fallback
                except Exception as e:
                    log(f"Error calculating drag coefficient: {e}", "error")
                    return 0.3 # Fallback

            def get_thrust(current_time: float) -> float:
                """Get current thrust based on thrust curve"""
                if projectile_type != 'rocket' or current_time > burn_time or not thrust_curve:
                    return 0
                times = sorted(thrust_curve.keys())
                if not times:
                    return 0
                if current_time <= times[0]:
                    return thrust_curve[times[0]]
                if current_time >= times[-1]:
                    return thrust_curve[times[-1]]
                # Linear interpolation between points
                for i in range(1, len(times)):
                    if current_time <= times[i]:
                        t0, t1 = times[i-1], times[i]
                        thrust0, thrust1 = thrust_curve[t0], thrust_curve[t1]
                        return linear_interpolate(current_time, t0, t1, thrust0, thrust1)
                return 0 # Fallback

            def derivatives(t: float, state_vec: List[float]) -> List[float]:
                """Calculates derivatives for RK4 integration."""
                x, y, vx, vy = state_vec
                speed = math.hypot(vx, vy)
                if speed == 0:
                    mach = 0
                    drag_force = 0
                else:
                    mach = speed / SPEED_OF_SOUND
                    cd = get_drag_coefficient(mach, drag_model)
                    density = get_air_density(y)
                    drag_force = 0.5 * cd * density * area * speed**2

                # Accelerations
                ax = 0.0
                ay = -GRAVITY

                # Drag acceleration (opposite to velocity direction)
                if speed > 0:
                    ax -= (drag_force / mass) * (vx / speed)
                    ay -= (drag_force / mass) * (vy / speed)

                # Wind effect (simplified: add wind velocity to projectile's frame)
                # This effectively changes the relative velocity used for drag
                v_rel_x = vx - wind_vx
                v_rel_y = vy - wind_vy
                v_rel = math.hypot(v_rel_x, v_rel_y)
                if v_rel > 0:
                    cd_rel = get_drag_coefficient(v_rel / SPEED_OF_SOUND, drag_model)
                    density = get_air_density(y)
                    drag_force_rel = 0.5 * cd_rel * density * area * v_rel**2
                    ax -= (drag_force_rel / mass) * (v_rel_x / v_rel)
                    ay -= (drag_force_rel / mass) * (v_rel_y / v_rel)

                # Thrust for rockets
                if projectile_type == 'rocket':
                    current_thrust = get_thrust(t)
                    if current_thrust > 0 and speed > 0:
                        # Assume thrust is along velocity vector
                        ax += (current_thrust / mass) * (vx / speed)
                        ay += (current_thrust / mass) * (vy / speed)
                    elif current_thrust > 0 and speed == 0:
                         # Initial thrust if starting from rest, assume vertical
                         ax += (current_thrust / mass) * math.cos(angle)
                         ay += (current_thrust / mass) * math.sin(angle)

                # Coriolis effect
                if coriolis:
                    # Simplified Coriolis acceleration in the horizontal plane
                    # Omega = 7.292115e-5 rad/s
                    # ax_coriolis = 2 * Omega * sin(lat) * vy
                    # ay_coriolis = -2 * Omega * sin(lat) * vx
                    coriolis_param = 2 * EARTH_ROTATION_RATE * math.sin(latitude)
                    ax_coriolis = coriolis_param * vy
                    ay_coriolis = -coriolis_param * vx
                    ax += ax_coriolis
                    ay += ay_coriolis
                    # log(f"Time {t:.3f}s: Coriolis Accel=(x:{ax_coriolis:.5f}, y:{ay_coriolis:.5f})") # Debug

                return [vx, vy, ax, ay]

            def rk4_step(t: float, state_vec: List[float], h: float) -> List[float]:
                """Performs one step of the RK4 integration."""
                k1 = [h * dx for dx in derivatives(t, state_vec)]
                k2 = [h * dx for dx in derivatives(t + h/2, [s + k/2 for s, k in zip(state_vec, k1)])]
                k3 = [h * dx for dx in derivatives(t + h/2, [s + k/2 for s, k in zip(state_vec, k2)])]
                k4 = [h * dx for dx in derivatives(t + h, [s + k for s, k in zip(state_vec, k3)])]
                return [s + (k1_i + 2*k2_i + 2*k3_i + k4_i)/6 for s, k1_i, k2_i, k3_i, k4_i in zip(state_vec, k1, k2, k3, k4)]

            # --- Save initial point ---
            initial_speed = math.hypot(state[2], state[3])
            trajectory.append((state[0], state[1], time, state[2], state[3], initial_speed))

            # --- RK4 integration with adaptive step size ---
            # (Note: This implementation uses a fixed step size 'dt' for simplicity.
            #  A full adaptive RK4 would adjust 'dt' based on error estimates.)
            while state[1] >= 0 and time < max_time:  # Continue while above ground and within time limit
                state = rk4_step(time, state, dt)
                time += dt
                current_speed = math.hypot(state[2], state[3])
                trajectory.append((state[0], state[1], time, state[2], state[3], current_speed))

            # --- Final Adjustments ---
            # Find impact point (y=0) by interpolating last two points
            if len(trajectory) >= 2 and trajectory[-1][1] < 0:
                p1 = trajectory[-2]
                p2 = trajectory[-1]
                # Linear interpolation to find x_impact when y=0
                if p2[1] != p1[1]: # Avoid division by zero
                    t_factor = (0 - p1[1]) / (p2[1] - p1[1])
                    x_impact = p1[0] + t_factor * (p2[0] - p1[0])
                    y_impact = 0.0
                    t_impact = p1[2] + t_factor * (p2[2] - p1[2])
                    vx_impact = p1[3] + t_factor * (p2[3] - p1[3])
                    vy_impact = p1[4] + t_factor * (p2[4] - p1[4])
                    v_impact = math.hypot(vx_impact, vy_impact)
                    # Replace last point with the precise impact point
                    trajectory[-1] = (x_impact, y_impact, t_impact, vx_impact, vy_impact, v_impact)
            elif len(trajectory) >= 1 and trajectory[-1][1] >= 0:
                 # Fallback: just set y to 0 if it never went negative (e.g., launched upwards from high altitude?)
                 # This case is less likely if launched from ground (y=altitude)
                 last = list(trajectory[-1])
                 last[1] = 0.0
                 trajectory[-1] = tuple(last)

            log(f"Trajectory calculation finished. Points generated: {len(trajectory)}")
            return trajectory

        except Exception as e:
            log(f"Error during internal trajectory calculation: {e}", "error")
            raise  # Re-raise to be caught by the thread

