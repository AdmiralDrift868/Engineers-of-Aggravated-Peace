        if self.mass_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Mass must be positive")
            return False
        if self.diam_input.value() <= 0:
            QMessageBox.warning(self, "Invalid Input", "Diameter must be positive")
